# 복사해서 infra/.env로 쓴다. 값을 비우면 docker-compose.yml의 기본값을 쓴다.
# docker compose와 앱(app/db.py, data/load.py)이 모두 이 파일을 읽는다.
# 이미 설정된 환경 변수가 있으면 그 값이 이긴다.

# 프로젝트 DB
POSTGRES_DB=pdm
POSTGRES_USER=pdm
POSTGRES_PASSWORD=pdm
# 호스트에 여는 포트. 로컬에서 앱은 localhost:이 포트로 붙는다.
# 앱을 컨테이너로 돌릴 때는 compose의 environment로 POSTGRES_HOST=postgres, POSTGRES_PORT=5432를 준다
POSTGRES_PORT=5432
